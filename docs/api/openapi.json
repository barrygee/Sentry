            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "identity_key": {
            "title": "Identity Key",
            "type": "string"
          },
          "identity_kind": {
            "enum": [
              "serial",
              "usb"
            ],
            "title": "Identity Kind",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs_identification": {
            "title": "Needs Identification",
            "type": "boolean"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OutputInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for an unconfigured device"
          },
          "present": {
            "title": "Present",
            "type": "boolean"
          },
          "processes": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProcessInfo"
              },
              {
                "type": "null"
              }
            ]
