        "type": "object"
      },
      "DevicesListResponse": {
        "description": "`GET /api/devices` body: every configured and every detected device.",
        "properties": {
          "constraints": {
            "$ref": "#/components/schemas/PortConstraints"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceRecord"
