          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "direct_sampling": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1,
                  2
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Direct-sampling mode, nullable",
            "title": "Direct Sampling"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "gain_auto": {
            "title": "Gain Auto",
            "type": "boolean"
          },
          "gain_db": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gain Db"
          },
          "identity_key": {
            "title": "Identity Key",
            "type": "string"
          },
          "identity_kind": {
            "enum": [
              "serial",
              "usb"
            ],
            "title": "Identity Kind",
