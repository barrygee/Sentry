          },
          "last_seen_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "last_serial": {
            "title": "Last Serial",
            "type": "string"
          },
          "last_topology_path": {
            "title": "Last Topology Path",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs_identification": {
            "title": "Needs Identification",
            "type": "boolean"
          },
          "output_port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Port"
          },
          "ppm_correction": {
            "title": "Ppm Correction",
            "type": "integer"
          },
          "present": {
            "title": "Present",
            "type": "boolean"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Id"
          },
          "sample_rate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Rate"
          },
          "state": {
            "enum": [
              "detected",
              "configured",
              "starting",
              "streaming",
              "degraded",
              "stopped",
              "error"
            ],
            "title": "State",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "integer"
          }
        },
        "required": [
          "device_id",
          "record_id",
          "identity_kind",
          "identity_key",
          "name",
          "description",
          "enabled",
          "gain_auto",
          "ppm_correction",
          "present",
          "needs_identification",
          "state",
          "last_topology_path",
          "last_serial",
          "created_at",
          "updated_at"
        ],
        "title": "DeviceRecord",
        "type": "object"
      },
      "DeviceStatus": {
        "description": "One device's realtime status \u2014 the `GET /api/status` and SSE payload shape.",
        "properties": {
          "clients": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClientCounts"
              },
              {
                "type": "null"
              }
