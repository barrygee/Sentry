          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "started_at",
          "uptime_s",
          "database",
          "hotplug",
          "devices"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HotplugHealth": {
