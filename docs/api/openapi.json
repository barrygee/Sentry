          }
        },
        "required": [
          "device_id",
          "operation_id",
          "status"
        ],
        "title": "SerialFlashAccepted",
        "type": "object"
      },
      "SerialFlashRequest": {
        "additionalProperties": false,
        "description": "Request body for flashing a unique serial to a dongle's EEPROM.",
        "properties": {
          "confirm": {
            "const": true,
            "description": "Must be exactly true; a destructive hardware write requires explicit intent",
            "title": "Confirm",
            "type": "boolean"
          },
          "serial": {
            "pattern": "^[A-Za-z0-9_-]{1,32}$",
            "title": "Serial",
            "type": "string"
          }
        },
        "required": [
          "serial",
          "confirm"
        ],
        "title": "SerialFlashRequest",
        "type": "object"
      },
      "StatusResponse": {
        "description": "`GET /api/status` and the SSE `snapshot` event body.",
        "properties": {
          "generated_at": {
            "description": "Unix ms this snapshot was assembled",
            "title": "Generated At",
            "type": "integer"
          },
          "sdrs": {
            "description": "Sorted by usb.topology_path; absent devices last",
            "items": {
              "$ref": "#/components/schemas/DeviceStatus"
            },
            "title": "Sdrs",
            "type": "array"
          }
        },
        "required": [
          "generated_at",
          "sdrs"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "TunerInfo": {
        "description": "The live tuner state as last observed via `control_follower` (architecture \u00a77.2).",
        "properties": {
          "bias_tee": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bias-T power state, when the dongle supports it",
            "title": "Bias Tee"
          },
          "center_hz": {
            "title": "Center Hz",
            "type": "integer"
          },
          "direct_sampling": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1,
                  2
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Direct-sampling mode (0=off, 1=I-ADC, 2=Q-ADC), when in use",
            "title": "Direct Sampling"
          },
          "gain_auto": {
            "title": "Gain Auto",
            "type": "boolean"
          },
          "gain_db": {
            "title": "Gain Db",
            "type": "number"
          },
          "locked": {
            "description": "Whether another owner currently holds the tuning token",
            "title": "Locked",
            "type": "boolean"
          },
          "observed_at": {
            "description": "Unix ms this state was last observed on P+2",
            "title": "Observed At",
            "type": "integer"
          },
          "sample_rate": {
            "title": "Sample Rate",
            "type": "integer"
          }
        },
        "required": [
          "center_hz",
          "sample_rate",
          "gain_db",
          "gain_auto",
          "locked",
          "observed_at"
        ],
        "title": "TunerInfo",
        "type": "object"
      },
      "UsbInfo": {
        "description": "The live USB descriptor and topology for a present device (architecture \u00a77.2).",
        "properties": {
          "bus_number": {
            "minimum": 0.0,
            "title": "Bus Number",
            "type": "integer"
          },
          "device_address": {
            "description": "Kernel devnum; unstable, display only",
            "title": "Device Address",
            "type": "integer"
          },
          "driver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bound kernel driver name, if any",
            "title": "Driver"
          },
          "driver_conflict": {
            "description": "True when the DVB kernel driver is bound instead of the userspace driver",
            "title": "Driver Conflict",
            "type": "boolean"
          },
          "hub_depth": {
            "description": "len(port_chain) - 1",
            "minimum": 0.0,
            "title": "Hub Depth",
            "type": "integer"
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manufacturer"
          },
          "port_chain": {
            "description": "The port path as integers, e.g. (1, 4, 2)",
            "items": {
              "type": "integer"
            },
            "title": "Port Chain",
            "type": "array"
          },
          "product": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product"
          },
          "product_id": {
            "description": "Lowercase hex, no \"0x\", e.g. \"2838\"",
            "title": "Product Id",
            "type": "string"
          },
          "serial": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The raw reported iSerial",
            "title": "Serial"
          },
          "topology_path": {
            "description": "Bus-port path, e.g. \"1-1.4.2\"",
            "title": "Topology Path",
            "type": "string"
          },
          "vendor_id": {
            "description": "Lowercase hex, no \"0x\", e.g. \"0bda\"",
            "title": "Vendor Id",
            "type": "string"
          }
        },
        "required": [
          "topology_path",
          "bus_number",
          "port_chain",
          "hub_depth",
          "device_address",
          "vendor_id",
          "product_id",
          "driver_conflict"
        ],
        "title": "UsbInfo",
        "type": "object"
      },
      "UsbLastKnownInfo": {
        "description": "A reduced USB description for a configured device that is currently absent.\n\nPopulated from the persisted `last_*` columns so an absent device still\nrenders identifiably in the UI (architecture \u00a77.2).",
        "properties": {
          "manufacturer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manufacturer"
          },
          "product": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "serial": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial"
          },
          "topology_path": {
            "title": "Topology Path",
            "type": "string"
          },
          "vendor_id": {
            "title": "Vendor Id",
            "type": "string"
          }
        },
        "required": [
          "topology_path",
          "vendor_id",
          "product_id"
        ],
        "title": "UsbLastKnownInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Multi-dongle RTL-SDR fleet manager for a Raspberry Pi.",
    "title": "Sentry",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/devices": {
      "get": {
        "description": "Return every configured device plus every detected-but-unconfigured one.",
        "operationId": "list_devices_api_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicesListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List configured and detected devices",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/devices/{device_id}": {
      "delete": {
        "description": "Remove a device's persisted configuration.\n\nConfig-removal only, and only for a device that is not currently present\n(settled contract, see module docstring): `404 unknown_device` for a\ndevice_id with no persisted row, `409 device_present` while it is plugged\nin, `204 No Content` otherwise.",
        "operationId": "delete_device_api_devices__device_id__delete",
        "parameters": [
          {
            "description": "Either \"serial:<value>\" or \"usb:<topology_path>\"",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "description": "Either \"serial:<value>\" or \"usb:<topology_path>\"",
              "examples": [
                "serial:ADSB-01"
              ],
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove a device's persisted configuration",
        "tags": [
          "devices"
        ]
      },
      "patch": {
        "description": "Upsert one device's configuration; creates the row on first call for a detected device.\n\nValidation order mirrors architecture \u00a77.5's response list: the device\nmust be known and identified before any conflict is checked, the proposed\nport is validated through the full six-rule `PortAllocatorService`\n(returning its specific rejection code, not a generic one), then the name\nis checked for a case-insensitive collision, and only then is the mutation\napplied \u2014 `DeviceConflictError` from the repository's unique indexes is\nstill caught as the last line of defence against a concurrent-request\nrace (architecture \u00a76.1).",
        "operationId": "patch_device_api_devices__device_id__patch",
        "parameters": [
          {
            "description": "Either \"serial:<value>\" or \"usb:<topology_path>\"",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "description": "Either \"serial:<value>\" or \"usb:<topology_path>\"",
              "examples": [
                "serial:ADSB-01"
              ],
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevicePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create or update a device's configuration",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/devices/{device_id}/serial": {
      "post": {
        "description": "Begin the guarded EEPROM serial-flash flow; the outcome arrives via SSE `notice`.\n\n`request.confirm`'s `Literal[True]` and `request.serial`'s allow-list\npattern are already enforced by Pydantic before this handler runs\n(architecture \u00a77.6 guards 1-2). This handler enforces guards 3-4 (serial\nuniqueness, device idleness) plus the per-device lock, then hands the\nactual guarded flash (charset re-check, per-device asyncio lock, list-argv\nexec) to `EepromService.flash_serial()` as a background task \u2014 the\nendpoint itself never performs the flash inline, matching the 202\ncontract.",
        "operationId": "flash_serial_api_devices__device_id__serial_post",
        "parameters": [
          {
            "description": "Either \"serial:<value>\" or \"usb:<topology_path>\"",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "description": "Either \"serial:<value>\" or \"usb:<topology_path>\"",
              "examples": [
                "serial:ADSB-01"
              ],
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SerialFlashRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SerialFlashAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Flash a unique serial to the dongle's EEPROM",
        "tags": [
          "devices"
        ]
      }
    },
    "/api/events": {
      "get": {
        "description": "Open an SSE stream of fleet events.\n\nThe response is `text/event-stream` and is not one flat JSON schema \u2014 the\nfrozen shape of each named event is documented in `schemas/device.py`,\n`schemas/events.py` and `schemas/health.py`. Client disconnect cancels the\nunderlying generator (Starlette's normal `StreamingResponse` behaviour),\nwhich the `finally` block above uses to release the bus subscription.",
        "operationId": "get_events_api_events_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Realtime fleet events (Server-Sent Events)",
        "tags": [
          "events"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Return the current health snapshot.\n\n200 unless the database is unreachable, in which case 503 with the same\nbody shape \u2014 a flapping healthcheck on one degraded dongle must never\nrestart the container and take the healthy dongles down with it\n(architecture \u00a77.1). No auth dependency is declared on this router: the\nDocker healthcheck must reach it regardless of `SENTRY_AUTH_TOKEN`.",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health snapshot",
        "tags": [
          "health"
        ]
      }
    },
    "/api/sdrs": {
      "get": {
        "description": "Permanent convenience alias serving the current stable SDR export version.",
        "operationId": "get_sdrs_alias_api_sdrs_get",
        "parameters": [
          {
            "in": "query",
            "name": "include_disabled",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Disabled",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "available_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Available Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdrExportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Permanent alias for the current stable /v1/sdrs",
        "tags": [
          "sdrs"
        ]
      }
    },
    "/api/status": {
      "get": {
        "description": "Return the realtime per-SDR view \u2014 identical payload to the SSE `snapshot` event.",
        "operationId": "get_status_api_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Realtime per-SDR status",
        "tags": [
          "status"
        ]
      }
    },
    "/api/v1/sdrs": {
      "get": {
        "description": "Return every configured device mapped onto Sentinel's `SdrRadio` field names.",
        "operationId": "get_sdrs_v1_api_v1_sdrs_get",
        "parameters": [
          {
            "in": "query",
            "name": "include_disabled",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Disabled",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "available_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Available Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdrExportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The Sentinel-consumed SDR export (versioned)",
        "tags": [
          "sdrs"
        ]
      }
    }
  }
}
