          "record_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The DB surrogate key; null for a detected device",
            "title": "Record Id"
          },
          "state": {
            "enum": [
              "detected",
              "configured",
              "starting",
              "streaming",
              "degraded",
              "stopped",
              "error"
