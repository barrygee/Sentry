            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Internal Range",
            "type": "array"
          },
          "port_max": {
            "title": "Port Max",
            "type": "integer"
          },
          "port_min": {
            "title": "Port Min",
