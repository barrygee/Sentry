{
  "components": {
    "schemas": {
      "ClientCounts": {
        "description": "Per-port connected-client counts from `SocketStatsSource`.\n\nEvery field is nullable and advisory: `None` on platforms without\n`/proc/net/tcp` (architecture decision \u2014 always nullable, never a hard\ndependency for status reporting).",
        "properties": {
          "control": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Control"
          },
          "iq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Iq"
          }
        },
        "title": "ClientCounts",
        "type": "object"
      },
      "DeviceCounts": {
        "description": "Per-state device tallies surfaced in the health snapshot.",
        "properties": {
          "configured": {
            "minimum": 0.0,
            "title": "Configured",
            "type": "integer"
          },
          "degraded": {
            "minimum": 0.0,
            "title": "Degraded",
            "type": "integer"
          },
          "error": {
            "minimum": 0.0,
            "title": "Error",
            "type": "integer"
          },
          "needs_identification": {
            "minimum": 0.0,
            "title": "Needs Identification",
            "type": "integer"
          },
          "present": {
            "minimum": 0.0,
            "title": "Present",
            "type": "integer"
          },
          "streaming": {
            "minimum": 0.0,
            "title": "Streaming",
            "type": "integer"
          }
        },
        "required": [
          "present",
          "configured",
          "streaming",
          "degraded",
          "error",
          "needs_identification"
        ],
        "title": "DeviceCounts",
        "type": "object"
      },
      "DevicePatch": {
        "additionalProperties": false,
        "description": "`PATCH /api/devices/{device_id}` request body \u2014 all fields optional, one required.\n\n`extra=\"forbid\"` rejects unknown fields outright rather than silently\nignoring operator typos (architecture \u00a712.12).",
        "properties": {
          "bias_tee": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bias Tee"
          },
          "center_hz": {
            "anyOf": [
              {
                "maximum": 1766000000.0,
                "minimum": 24000000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Center Hz"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "direct_sampling": {
            "anyOf": [
              {
                "enum": [
                  0,
                  1,
                  2
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direct Sampling"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "gain_auto": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gain Auto"
          },
          "gain_db": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gain Db"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "output_port": {
            "anyOf": [
              {
                "maximum": 65533.0,
                "minimum": 1024.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Port"
          },
          "ppm_correction": {
            "anyOf": [
              {
                "maximum": 200.0,
                "minimum": -200.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ppm Correction"
          },
          "sample_rate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Rate"
          }
        },
        "title": "DevicePatch",
        "type": "object"
      },
      "DeviceRecord": {
