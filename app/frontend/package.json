{
  "name": "sentry-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run build:js && npm run build:css && npm run build:static",
    "build:js": "tsc",
    "build:css": "tailwindcss --input src/styles/input.css --output dist/app.css --minify",
    "build:static": "node scripts/copy-static.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api-types": "openapi-typescript ../../docs/api/openapi.json -o src/api/types.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  }
}
