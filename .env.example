# Sentry configuration — copy to `.env` and adjust. Every variable here has a
# documented default in app/backend/config.py; nothing here is a real secret.
# See docs/architecture/sentry-sdr-controller.md §3.4 for the authoritative table.

# API/SPA bind address and port.
SENTRY_HTTP_HOST=0.0.0.0
SENTRY_HTTP_PORT=8000

# Host published in GET /api/v1/sdrs. Leave unset to derive it from the
# request's Host header; set explicitly if Sentry sits behind NAT/a proxy.
# When set, it is published to hotspot-joined clients too — who cannot reach a
# LAN address. The hotspot panel shows the address those clients should use.
# SENTRY_ADVERTISED_HOST=192.168.1.45

# Async SQLAlchemy database URL (SQLite + WAL; ADR-0005).
SENTRY_DATABASE_URL=sqlite+aiosqlite:////data/sentry.db

# Bearer token required on every /api/** route (except /api/health) when set.
# Unset (the default) disables auth entirely — appropriate only on a trusted LAN.
# SENTRY_AUTH_TOKEN=replace-with-a-long-random-value

# Bounds the internal loopback port range and USB bandwidth budget.
SENTRY_MAX_DEVICES=8
SENTRY_INTERNAL_PORT_BASE=14000

# Extra operator deny-list of ports Sentry must never assign, comma-separated.
SENTRY_RESERVED_PORTS=

# Overridden by tests to point at a fixture sysfs tree.
SENTRY_SYSFS_ROOT=/sys

# Sysfs sweep period (the hotplug reconcile safety net), in seconds.
SENTRY_RECONCILE_INTERVAL_S=2.0

# Binary paths, only needed if not on $PATH inside the container.
SENTRY_RTL_TCP_PATH=rtl_tcp
SENTRY_RTL_EEPROM_PATH=rtl_eeprom

# SENTRY_RELAY_PATH is deliberately NOT set here. The relay ships inside the
# backend package, so Sentry derives its location from the package itself and is
# correct in both the container (/srv/sentry/app/backend/relay/) and a checkout
# without Docker. Any absolute value written here is wrong in one of those two,
# and setting it wrongly breaks every dongle at once: rtl_tcp starts, the relay
# cannot be found, the pair dies, and the supervisor reports a crash loop that
# looks exactly like a hardware fault. Only set it if you are running a relay
# from somewhere other than the package.

SENTRY_LOG_LEVEL=INFO

# Comma-separated CORS allow-list for a separately-hosted dev frontend.
# Empty (the default) closes CORS entirely — the production SPA is same-origin.
# Never set this to "*".
SENTRY_CORS_ORIGINS=

# ── WiFi hotspot (ADR-0007) ───────────────────────────────────────────────────
# Lets Sentry run its own WiFi network so Sentinel clients can reach the SDRs
# with no LAN. Entirely additive: with control off, nothing here has any effect
# and Sentry behaves exactly as it did before.

# The master switch. OFF by default — this is the one setting that gives a
# LAN-facing API control of the host's networking. Requires the D-Bus socket
# mount in docker-compose.yml and NetworkManager on the host.
SENTRY_HOTSPOT_CONTROL_ENABLED=false

# Refuse every hotspot change while SENTRY_AUTH_TOKEN is unset. Leave this true:
# an access point puts anyone in radio range who has the passphrase on the same
# network as an API that spawns processes and writes dongle firmware.
SENTRY_HOTSPOT_REQUIRE_AUTH_TOKEN=true

# The single NetworkManager connection profile Sentry owns. It never reads,
# edits or deletes any other profile on the host.
SENTRY_HOTSPOT_CONNECTION_NAME=sentry-hotspot

# Wireless interface for the hotspot. Leave unset to choose automatically —
# automatic never picks a radio that is already carrying a connection, so
# enabling the hotspot cannot silently drop the Pi's own uplink.
# SENTRY_HOTSPOT_INTERFACE=wlan0

# The Pi's address on the hotspot network, and therefore the address a joined
# client types into Sentinel. Pinned rather than left to NetworkManager so it
# never moves between activations. Private ranges only, /16 to /30.
SENTRY_HOTSPOT_GATEWAY_CIDR=10.42.0.1/24

# How long an operator has to confirm a hotspot before it rolls itself back.
# The safety net against configuring a network nobody can reach: an activation
# only survives a reboot once someone has proved the API is still reachable.
SENTRY_HOTSPOT_CONFIRM_TIMEOUT_S=120.0

# nmcli binary path and per-command timeout.
SENTRY_NMCLI_PATH=nmcli
SENTRY_NMCLI_TIMEOUT_S=20.0

# Where NetworkManager keeps its dnsmasq lease files, the source for
# GET /api/hotspot/clients. Overridden by tests to point at a fixture tree.
SENTRY_NM_STATE_ROOT=/var/lib/NetworkManager
